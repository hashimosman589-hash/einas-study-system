PORT=5000
JWT_SECRET=einas-super-secret-change-me
JWT_EXPIRES=7d
# مفتاح API اختياري (متوافق مع OpenAI). اتركه فارغًا ليعمل النظام بالمحلل المحلي الاحتياطي.
# المزود الحالي: OpenRouter.
AI_API_KEY=
AI_BASE_URL=https://openrouter.ai/api/v1
# النموذج: google/gemini-2.5-flash هو الأسرع اختُتبارًا (~6-8x أسرع من deepseek/deepseek-v4-flash)
# في توليد JSON العربي/الإنجليزي الطويل، مع أسئلة وملخص باللغة الواحدة (لغة الملف) بلا ترجمة ثنائية.
AI_MODEL=google/gemini-2.5-flash
# توازٍ عبر أجزاء التحليل وسقف توكنات الدقيقة (اختياري)
AI_PIPELINE_CONCURRENCY=6
AI_TPM_LIMIT=200000
# حجم جزء التحليل بالحروف (4000-60000). 24000 = توازن مُقاس:
# لا خسارة محتوى للملفات الصغيرة (عدد أسئلة مساوٍ) وتسريع ~24% للملفات الكبيرة
# (أجزاء أقل = استدعاءات توليد أقل لنفس التغطية). جرّب أعلاه (48K/60K) مع أسئلة لكل
# جزء أعلى إذا رغبت بأقصى سرعة للملفات الكبيرة مهما كانت تكلفة عدد الأسئلة الإجمالي.
AI_CHUNK_SIZE=24000
AI_VALIDATE_MIN=999
AI_QUESTIONS_PER_PART=7
AI_WORKER_CONCURRENCY=2
AI_JOB_MAX_ATTEMPTS=3
AI_JOB_RETRY_BASE_MS=3000
# على الاستضافة: أي بريد مدرج هنا يُرفع إلى صلاحية مدير عند الإقلاع
ADMIN_EMAILS=
# على الاستضافة: مسار قرص دائم للبيانات (SQLite + المرفوعات). اتركه فارغًا محليًا.
DATA_DIR=
